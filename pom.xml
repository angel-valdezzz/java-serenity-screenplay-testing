    <plugin><groupId>net.serenity-bdd.maven.plugins</groupId><artifactId>serenity-maven-plugin</artifactId><version>5.3.8</version><executions><execution><phase>verify</phase><goals><goal>aggregate</goal></goals></execution></executions></plugin></plugins></build></project>