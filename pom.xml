<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion><groupId>io.github.angelvaldezzz</groupId><artifactId>java-serenity-screenplay-testing</artifactId><version>0.1.0</version>
    <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
    <dependencies><dependency><groupId>net.serenity-bdd</groupId><artifactId>serenity-core</artifactId><version>5.3.8</version><scope>test</scope></dependency><dependency><groupId>net.serenity-bdd</groupId><artifactId>serenity-junit5</artifactId><version>5.3.8</version><scope>test</scope></dependency><dependency><groupId>net.serenity-bdd</groupId><artifactId>serenity-screenplay</artifactId><version>5.3.8</version><scope>test</scope></dependency><dependency><groupId>net.serenity-bdd</groupId><artifactId>serenity-screenplay-webdriver</artifactId><version>5.3.8</version><scope>test</scope></dependency><dependency><groupId>net.serenity-bdd</groupId><artifactId>serenity-screenplay-rest</artifactId><version>5.3.8</version><scope>test</scope></dependency><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.0.3</version><scope>test</scope></dependency></dependencies>
    <build><testResources><testResource><directory>src/test/java</directory><excludes><exclude>**/*.java</exclude></excludes></testResource><testResource><directory>src/test/resources</directory></testResource></testResources><plugins>
